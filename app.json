{
  "expo": {
    "name": "Roomly",
    "slug": "roomly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "roomly",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/4287ec94-5a1f-430a-a130-07279e1a1dab"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.anonymous.roomly"
    },
    "android": {
      "package": "com.anonymous.roomly",
      "adaptiveIcon": {
        "backgroundColor": "#208AEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-android-build-memory.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Roomly to select receipt photos.",
          "cameraPermission": "Allow Roomly to photograph receipts.",
          "microphonePermission": false
        }
      ],
      "./plugins/with-receipt-permissions.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "baseUrl": "/roomly"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4287ec94-5a1f-430a-a130-07279e1a1dab"
      }
    }
  }
}
